<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:titleTextColor="@android:color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/background_gray_50"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Event Statistics"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvWaitlistCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Waitlist: 0"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvInvitedCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Invited: 0"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvConfirmedCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Confirmed: 0"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Action Buttons -->
            <Button
                android:id="@+id/btnInviteUsers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/invite_entrants_to_private_event"
                android:layout_marginBottom="8dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <Button
                android:id="@+id/btnViewInvited"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_invited_entrants"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/status_waiting_yellow" />

            <Button
                android:id="@+id/btnViewConfirmed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_confirmed_entrants"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/status_confirmed_green" />

            <Button
                android:id="@+id/btnDrawLottery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Draw Lottery"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/primary_blue" />

            <Button
                android:id="@+id/btnSendNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send Notifications"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/secondary_purple" />

            <Button
                android:id="@+id/btnExportCSV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export CSV"
                style="@style/Widget.Material3.Button.OutlinedButton" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
