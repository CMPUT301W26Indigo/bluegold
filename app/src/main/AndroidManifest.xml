<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.eventlottery">
    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" /> <!-- Camera feature (optional for devices without camera) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".EventLotteryApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EventLotterySystem"
        tools:targetApi="31">
        <!-- Handle Android 16 Resizability Override for Large Screens -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

         <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Entrant Activities -->
        <activity
            android:name=".ui.entrant.BrowseEventsActivity"
            android:exported="false"
            android:label="@string/browse_events_title"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:name=".ui.entrant.EventDetailsActivity"
            android:exported="false"
            android:label="@string/event_details_title"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EventLotterySystem"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:name=".ui.entrant.MyEventsActivity"
            android:exported="false"
            android:label="@string/my_events_title"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:name=".ui.entrant.NotificationsActivity"
            android:exported="false"
            android:label="@string/notifications_title"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:name=".ui.entrant.ProfileActivity"
            android:exported="false"
            android:label="@string/profile_title"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" /> <!-- Organizer Activities -->
        <activity
            android:name=".ui.organizer.OrganizerDashboardActivity"
            android:exported="false"
            android:label="@string/my_events_organizer"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:name=".ui.organizer.CreateEventActivity"
            android:exported="false"
            android:label="@string/create_event_title"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:name=".ui.organizer.ManageEventActivity"
            android:exported="false"
            android:label="@string/manage_event"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:name=".ui.organizer.DrawLotteryActivity"
            android:exported="false"
            android:label="@string/lottery_draw_title"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" /> <!-- Admin Activities -->
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false"
            android:label="@string/admin_dashboard_title"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:name=".ui.admin.ManageEventsActivity"
            android:exported="false"
            android:label="@string/manage_events_title"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:name=".ui.admin.ReviewImagesActivity"
            android:exported="false"
            android:label="@string/review_images_title"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:name=".ui.admin.ManageUsersActivity"
            android:exported="false"
            android:label="@string/manage_users_title"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <!-- QR Code Scanner Activity -->
        <activity
            android:name=".ui.qr.QRScannerActivity"
            android:exported="false"
            android:label="Scan QR Code"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            tools:ignore="LockedOrientationActivity" />
        <!-- Firebase Cloud Messaging Service (if using Firebase) -->
        <service
            android:name=".services.FCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service> <!-- Location Service -->
        <service
            android:name=".services.LocationService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>